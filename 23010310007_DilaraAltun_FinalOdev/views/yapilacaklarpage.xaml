<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_23010310007_DilaraAltun_FinalOdev.views.yapilacaklarpage"
             Title="Yapılacaklar Listesi">

    <Grid RowDefinitions="*,Auto">

        <CollectionView x:Name="TodoList"
                        Grid.Row="0"
                        SelectionMode="Single"
                        SelectionChanged="OnGorevSecildi">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10" Padding="10" CornerRadius="12" HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Baslik}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Detay}" FontSize="14" TextColor="Gray" MaxLines="2" />
                                <Label Text="{Binding TarihSaat, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       FontSize="12" TextColor="DarkGray" />
                            </VerticalStackLayout>

                            <CheckBox Grid.Column="1" IsChecked="{Binding YapildiMi}" VerticalOptions="Center" />

                            <Button Grid.Column="2" Text="🗑" BackgroundColor="Transparent" Clicked="OnSilClicked" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="➕ Görev Ekle"
                Margin="20"
                Clicked="OnEkleClicked" />

    </Grid>
</ContentPage>

