<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_23010310007_DilaraAltun_FinalOdev.views.haberlerpage"
             Title="Haberler">
    <VerticalStackLayout>

       
        <Picker x:Name="KategoriPicker"
                Title="Kategori Seçiniz"
                SelectedIndexChanged="OnKategoriDegisti"
                Margin="10" />

       
        <ActivityIndicator x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           VerticalOptions="Center" />

        
        <CollectionView x:Name="HaberlerList"
                        SelectionMode="Single"
                        SelectionChanged="OnHaberSecildi">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10"
               Padding="0"
               CornerRadius="12"
               HasShadow="True"
               BorderColor="#E0E0E0">

                        <VerticalStackLayout>
                            <Image Source="{Binding ImageSafe}"
                       HeightRequest="180"
                       Aspect="AspectFill"
                       BackgroundColor="LightGray" />

                            <Label Text="{Binding title}"
                       Padding="12"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="Black" />
                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>