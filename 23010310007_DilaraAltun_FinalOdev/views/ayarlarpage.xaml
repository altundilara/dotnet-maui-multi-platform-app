<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_23010310007_DilaraAltun_FinalOdev.views.ayarlarpage">
    <VerticalStackLayout Padding="30" Spacing="20">
        <Label Text="Uygulama Ayarları" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
        <Frame CornerRadius="10" BackgroundColor="#F0F0F0">
            <HorizontalStackLayout Spacing="20">
                <Label Text="Koyu Mod" VerticalOptions="Center" FontSize="18" />
                <Switch x:Name="ThemeSwitch" Toggled="OnThemeToggled" />
            </HorizontalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>
